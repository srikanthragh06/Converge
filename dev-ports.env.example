# Per-worktree host ports for docker-compose.dev.yml.
#
# Copy this file to dev-ports.<feature-name>.env (gitignored, matched by
# the dev-ports.*.env pattern) and set values so this worktree's dev stack
# doesn't collide with another worktree's on the same machine. Values below
# are the defaults (same as running with no --env-file at all) — shift all
# six by the same offset for another worktree, e.g. +1000:
#   POSTGRES_HOST_PORT=6432
#   REDIS_HOST_PORT=7379
#   SERVER1_HOST_PORT=6000
#   SERVER2_HOST_PORT=6001
#   WEB1_HOST_PORT=6173
#   WEB2_HOST_PORT=6174
#
# Run with:
#   docker compose --env-file dev-ports.<feature-name>.env -f docker-compose.dev.yml up

POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
SERVER1_HOST_PORT=5000
SERVER2_HOST_PORT=5001
WEB1_HOST_PORT=5173
WEB2_HOST_PORT=5174
